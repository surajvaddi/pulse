{
  "name": "@pulseshift/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"prisma/**/*.ts\"",
    "test": "tsc --noEmit",
    "db:generate": "DATABASE_URL=${DATABASE_URL:-postgresql://pulseshift:pulseshift@localhost:5432/pulseshift?schema=public} prisma generate --schema prisma/schema.prisma",
    "db:validate": "DATABASE_URL=${DATABASE_URL:-postgresql://pulseshift:pulseshift@localhost:5432/pulseshift?schema=public} prisma validate --schema prisma/schema.prisma",
    "db:migrate": "DATABASE_URL=${DATABASE_URL:-postgresql://pulseshift:pulseshift@localhost:5432/pulseshift?schema=public} prisma migrate dev --schema prisma/schema.prisma",
    "db:push": "DATABASE_URL=${DATABASE_URL:-postgresql://pulseshift:pulseshift@localhost:5432/pulseshift?schema=public} prisma db push --schema prisma/schema.prisma",
    "db:seed": "DATABASE_URL=${DATABASE_URL:-postgresql://pulseshift:pulseshift@localhost:5432/pulseshift?schema=public} tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "tsx": "^4.22.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
