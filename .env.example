# Local Docker PostgreSQL or Supabase pooled connection.
DATABASE_URL="postgresql://pulseshift:pulseshift@localhost:5432/pulseshift?schema=public"

# Direct PostgreSQL connection for Prisma migrations. In Supabase, use the direct connection string.
DIRECT_URL="postgresql://pulseshift:pulseshift@localhost:5432/pulseshift?schema=public"

REDIS_URL="redis://localhost:6379"
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
WEB_ORIGINS="http://localhost:3000,http://localhost:3001"
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"
API_PORT="4000"
API_HOST="127.0.0.1"
ENABLE_DEMO_AUTH="true"
ENABLE_DEMO_RESET="true"
AUTH_PERSISTENCE="memory"
WORKFLOW_PERSISTENCE="memory"

# Supabase server-side settings. Never expose the service role key to the browser.
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_ANON_KEY="local-anon-key"
SUPABASE_SERVICE_ROLE_KEY="local-service-role-key"
SUPABASE_JWT_SECRET="local-jwt-secret"

# Supabase browser settings.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="local-anon-key"

# OpenAI-compatible LLM gateway settings.
LLM_PROVIDER="mock"
LLM_PROVIDER_ENABLED="false"
LLM_MODEL="gpt-4.1-mini"
LLM_TIMEOUT_MS="8000"
LLM_LIVE_SMOKE="false"
AI_GATEWAY_BASE_URL=""
AI_GATEWAY_API_KEY=""
OPENAI_API_KEY=""
